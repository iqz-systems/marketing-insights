# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE WRAPPER JDBC bv_promotions
    FOLDER = '/1 - dataconnection/2 - base views'
    DATASOURCENAME=ds_sql_marketing_insightsdb
    CATALOGNAME='${databases.marketing_insights.folder.1 - dataconnection.folder.2 - base views.views.jdbc.bv_promotions.CATALOGNAME}' 
    SCHEMANAME='${databases.marketing_insights.folder.1 - dataconnection.folder.2 - base views.views.jdbc.bv_promotions.SCHEMANAME}' 
    RELATIONNAME='promotions' 
    OUTPUTSCHEMA (
        promotion_id = 'promotion_id' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', description='', sourcetypeid='-5', sourcetypename='BIGINT')  SORTABLE,
        promotion_name = 'promotion_name' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='100', description='', sourcetypeid='12', sourcetypename='VARCHAR')  SORTABLE,
        start_date = 'start_date' :'java.time.LocalDate' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='10', description='', sourcetypeid='91', sourcetypename='DATE')  SORTABLE,
        end_date = 'end_date' :'java.time.LocalDate' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='10', description='', sourcetypeid='91', sourcetypename='DATE')  SORTABLE,
        discount_percentage = 'discount_percentage' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='2', sourcetyperadix='10', sourcetypesize='5', description='', sourcetypeid='3', sourcetypename='DECIMAL')  SORTABLE,
        promotion_type = 'promotion_type' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='50', description='', sourcetypeid='12', sourcetypename='VARCHAR')  SORTABLE,
        date_created = 'date_created' :'java.time.LocalDateTime' (OPT) (sourcetypedecimals='9', sourcetyperadix='0', sourcetypesize='29', description='', sourcetypeid='93', sourcetypename='TIMESTAMP')  SORTABLE
    );

CREATE OR REPLACE TABLE bv_promotions I18N us_est (
        promotion_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Represents a unique identifier for each promotion, ensuring distinct tracking and referencing of promotional activities.'),
        promotion_name:text (sourcetypeid = '12', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '100', description = 'Specifies the title or name of the promotion, providing clarity and recognition for each campaign. It includes values like "Flash Sale", "Back to School", "Winter Clearance", and "Black Friday".') TAGS (promotions),
        start_date:localdate (sourcetypeid = '91', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Indicates the date on which the promotion begins, allowing for precise scheduling and planning of promotional activities.'),
        end_date:localdate (sourcetypeid = '91', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Represents the date on which the promotion concludes, defining the time frame for its availability.'),
        discount_percentage:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '5', description = 'Details the percentage discount offered during the promotion, providing insight into the value proposition for customers.') TAGS (discount),
        promotion_type:text (sourcetypeid = '12', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '50', description = 'Describes the category or style of the promotion, aiding in the classification of campaign strategies. It includes values like "Clearance", "Seasonal", "BOGO", and "Flash Sale".') TAGS (promotion_type),
        date_created:timestamp (sourcetypeid = '93', sourcetyperadix = '0', sourcetypedecimals = '9', sourcetypesize = '29', description = 'Captures the date and time when the promotion record was created, serving as an audit point for data management.')
    )
    FOLDER = '/1 - dataconnection/2 - base views'
    DESCRIPTION = 'The bv_promotions view contains comprehensive details about various promotional campaigns. It includes fields such as a unique identifier for each promotion (promotion_id), the name of the promotion (promotion_name), start and end dates (start_date and end_date), the discount percentage offered (discount_percentage), the type of promotion (promotion_type), and the timestamp for when the promotion record was created (date_created). These fields provide a structured overview of promotional activities, including their scheduling, classification, and discount offers. The bv_promotions view could be used for tracking and managing promotional campaigns effectively, scheduling promotional activities, analyzing discount strategies, auditing records for promotional data, and categorizing campaigns based on their type.'
    CACHE OFF
    BATCHSIZEINCACHE DEFAULT
    TIMETOLIVEINCACHE NOEXPIRE
    ADD SEARCHMETHOD bv_promotions(
        I18N us_est
        CONSTRAINTS (
             ADD promotion_id (any) OPT ANY
             ADD promotion_name (any) OPT ANY
             ADD start_date (any) OPT ANY
             ADD end_date (any) OPT ANY
             ADD discount_percentage (any) OPT ANY
             ADD promotion_type (any) OPT ANY
             ADD date_created (any) OPT ANY
        )
        OUTPUTLIST (date_created, discount_percentage, end_date, promotion_id, promotion_name, promotion_type, start_date
        )
        WRAPPER (jdbc bv_promotions)
    );

