# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE WRAPPER JDBC bv_marketing_assets
    FOLDER = '/1 - dataconnection/2 - base views'
    DATASOURCENAME=ds_postgres_marketing_insights
    CATALOGNAME='${databases.marketing_insights.folder.1 - dataconnection.folder.2 - base views.views.jdbc.bv_marketing_assets.CATALOGNAME}' 
    SCHEMANAME='${databases.marketing_insights.folder.1 - dataconnection.folder.2 - base views.views.jdbc.bv_marketing_assets.SCHEMANAME}' 
    RELATIONNAME='marketing_assets' 
    OUTPUTSCHEMA (
        asset_id = 'asset_id' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', description='', sourcetypeid='-5', sourcetypename='BIGINT')  SORTABLE,
        asset_name = 'asset_name' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='100', description='', sourcetypeid='12', sourcetypename='VARCHAR')  SORTABLE,
        asset_type = 'asset_type' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='50', description='', sourcetypeid='12', sourcetypename='VARCHAR')  SORTABLE,
        campaign_id = 'campaign_id' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', description='', sourcetypeid='-5', sourcetypename='BIGINT')  SORTABLE,
        uploaded_by = 'uploaded_by' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='100', description='', sourcetypeid='12', sourcetypename='VARCHAR')  SORTABLE,
        upload_date = 'upload_date' :'java.time.LocalDate' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='10', description='', sourcetypeid='91', sourcetypename='DATE')  SORTABLE,
        file_path = 'file_path' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='2147483647', description='', sourcetypeid='12', sourcetypename='VARCHAR')  SORTABLE,
        date_created = 'date_created' :'java.time.LocalDateTime' (OPT) (sourcetypedecimals='9', sourcetyperadix='0', sourcetypesize='29', description='', sourcetypeid='93', sourcetypename='TIMESTAMP')  SORTABLE
    );

CREATE OR REPLACE TABLE bv_marketing_assets I18N us_est (
        asset_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Serves as a unique identifier for individual marketing assets within the dataset.'),
        asset_name:text (sourcetypeid = '12', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '100', description = 'Represents the name or title of the marketing asset. It includes values like "Promo Video", "Banner Ad", "Flyer", and "This is a very long...".'),
        asset_type:text (sourcetypeid = '12', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '50', description = 'Defines the category or format of the asset, such as "Document", "Image", "Video", and "Audio".'),
        campaign_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Indicates the identifier of the associated marketing campaign under which the asset falls.'),
        uploaded_by:text (sourcetypeid = '12', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '100', description = 'Specifies the name of the user who uploaded the asset. It includes values like "Hung", "Saturnina", "Conrad", and "Burl".'),
        upload_date:localdate (sourcetypeid = '91', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Records the date when the asset was uploaded into the system.'),
        file_path:text (sourcetypeid = '12', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '2147483647', description = 'Indicates the storage location or directory path of the asset file. It includes values like "/assets/Promo_Video.do...", "/assets/Promo_Video.im...", "/assets/Banner_Ad.do...", and "/assets/Flyer.video".'),
        date_created:timestamp (sourcetypeid = '93', sourcetyperadix = '0', sourcetypedecimals = '9', sourcetypesize = '29', description = 'Captures the timestamp when the record of the asset was created in the system.')
    )
    FOLDER = '/1 - dataconnection/2 - base views'
    DESCRIPTION = 'The bv_marketing_assets view represents a dataset containing detailed information about marketing assets. It includes fields such as asset identifiers, names, types, associated campaign IDs, uploader details, upload dates, file storage paths, and creation timestamps. This structured data allows for the organization and tracking of marketing materials within a system. The view could be used for managing and organizing marketing assets within a digital system. It can support tracking the lifecycle of assets, analyzing their usage by campaigns, identifying contributors, and facilitating efficient storage and retrieval of marketing materials.'
    CACHE OFF
    BATCHSIZEINCACHE DEFAULT
    TIMETOLIVEINCACHE NOEXPIRE
    ADD SEARCHMETHOD bv_marketing_assets(
        I18N us_est
        CONSTRAINTS (
             ADD asset_id (any) OPT ANY
             ADD asset_name (any) OPT ANY
             ADD asset_type (any) OPT ANY
             ADD campaign_id (any) OPT ANY
             ADD uploaded_by (any) OPT ANY
             ADD upload_date (any) OPT ANY
             ADD file_path (any) OPT ANY
             ADD date_created (any) OPT ANY
        )
        OUTPUTLIST (asset_id, asset_name, asset_type, campaign_id, date_created, file_path, upload_date, uploaded_by
        )
        WRAPPER (jdbc bv_marketing_assets)
    );

