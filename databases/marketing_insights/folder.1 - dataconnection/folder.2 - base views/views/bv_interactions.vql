# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE WRAPPER JDBC bv_interactions
    FOLDER = '/1 - dataconnection/2 - base views'
    DATASOURCENAME=ds_sql_marketing_insightsdb
    CATALOGNAME='${databases.marketing_insights.folder.1 - dataconnection.folder.2 - base views.views.jdbc.bv_interactions.CATALOGNAME}' 
    SCHEMANAME='${databases.marketing_insights.folder.1 - dataconnection.folder.2 - base views.views.jdbc.bv_interactions.SCHEMANAME}' 
    RELATIONNAME='interactions' 
    OUTPUTSCHEMA (
        interaction_id = 'interaction_id' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', description='', sourcetypeid='-5', sourcetypename='BIGINT')  SORTABLE,
        lead_id = 'lead_id' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', description='', sourcetypeid='-5', sourcetypename='BIGINT')  SORTABLE,
        interaction_type = 'interaction_type' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='50', description='', sourcetypeid='12', sourcetypename='VARCHAR')  SORTABLE,
        interaction_date = 'interaction_date' :'java.time.LocalDateTime' (OPT) (sourcetypedecimals='9', sourcetyperadix='0', sourcetypesize='29', description='', sourcetypeid='93', sourcetypename='TIMESTAMP')  SORTABLE,
        notes = 'notes' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='2147483647', description='', sourcetypeid='12', sourcetypename='VARCHAR')  SORTABLE,
        date_created = 'date_created' :'java.time.LocalDateTime' (OPT) (sourcetypedecimals='9', sourcetyperadix='0', sourcetypesize='29', description='', sourcetypeid='93', sourcetypename='TIMESTAMP')  SORTABLE
    );

CREATE OR REPLACE TABLE bv_interactions I18N us_est (
        interaction_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Serves as a distinct identifier for each recorded interaction, enabling unique tracking within the system.'),
        lead_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Links each interaction to a specific lead, facilitating the association between interactions and potential customer records.'),
        interaction_type:text (sourcetypeid = '12', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '50', description = 'Represents the nature or category of the interaction, providing insights into how engagements occur. It includes values like "phone call", "meeting", "webinar", and "demo".') TAGS (interaction_type),
        interaction_date:timestamp (sourcetypeid = '93', sourcetyperadix = '0', sourcetypedecimals = '9', sourcetypesize = '29', description = 'Captures the date and time of an interaction, enabling the tracking of engagement timelines and historical activity.'),
        notes:text (sourcetypeid = '12', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '2147483647', description = 'Contains remarks or observations related to the interaction, offering contextual details for future reference. It includes values like "Sent follow-up ema...", "Scheduled meeting ...", and "Sent follow-up ema...".'),
        date_created:timestamp (sourcetypeid = '93', sourcetyperadix = '0', sourcetypedecimals = '9', sourcetypesize = '29', description = 'Records the timestamp when the interaction entry was created, ensuring accurate data creation tracking.')
    )
    FOLDER = '/1 - dataconnection/2 - base views'
    DESCRIPTION = 'The bv_interactions view contains detailed records of interactions between a business and its leads or potential customers. It includes fields such as interaction_id, lead_id, interaction_type, interaction_date, notes, and date_created. The interaction_id serves as a unique identifier for each interaction, while lead_id links the interaction to a specific lead for easier traceability. The interaction_type specifies the category of engagement, such as phone call, webinar, or meeting. Interaction_date captures the date and time of the interaction, providing historical context, while notes offer additional details or remarks about the engagement. The date_created field tracks when the data entry was initially recorded. Additionally, the view is associated with bv_leads, linking interactions to lead information. This view could be used for tracking and analyzing engagement activities with leads, monitoring the timeline of interactions, maintaining detailed records for customer relationship management (CRM), and enabling businesses to gain insights into their interaction patterns with potential customers. It can also assist in understanding what types of interactions are more effective and help improve customer engagement strategies.'
    CACHE OFF
    BATCHSIZEINCACHE DEFAULT
    TIMETOLIVEINCACHE NOEXPIRE
    ADD SEARCHMETHOD bv_interactions(
        I18N us_est
        CONSTRAINTS (
             ADD interaction_id (any) OPT ANY
             ADD lead_id (any) OPT ANY
             ADD interaction_type (any) OPT ANY
             ADD interaction_date (any) OPT ANY
             ADD notes (any) OPT ANY
             ADD date_created (any) OPT ANY
        )
        OUTPUTLIST (date_created, interaction_date, interaction_id, interaction_type, lead_id, notes
        )
        WRAPPER (jdbc bv_interactions)
    );

