# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE WRAPPER JDBC bv_lead_conversion_log
    FOLDER = '/1 - dataconnection/2 - base views'
    DATASOURCENAME=ds_sql_marketing_insightsdb
    CATALOGNAME='${databases.marketing_insights.folder.1 - dataconnection.folder.2 - base views.views.jdbc.bv_lead_conversion_log.CATALOGNAME}' 
    SCHEMANAME='${databases.marketing_insights.folder.1 - dataconnection.folder.2 - base views.views.jdbc.bv_lead_conversion_log.SCHEMANAME}' 
    RELATIONNAME='lead_conversion_log' 
    OUTPUTSCHEMA (
        log_id = 'log_id' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', description='', sourcetypeid='-5', sourcetypename='BIGINT')  SORTABLE,
        lead_id = 'lead_id' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', description='', sourcetypeid='-5', sourcetypename='BIGINT')  SORTABLE,
        conversion_date = 'conversion_date' :'java.time.LocalDate' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='10', description='', sourcetypeid='91', sourcetypename='DATE')  SORTABLE,
        converted_customer_id = 'converted_customer_id' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', description='', sourcetypeid='-5', sourcetypename='BIGINT')  SORTABLE,
        conversion_source = 'conversion_source' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='100', description='', sourcetypeid='12', sourcetypename='VARCHAR')  SORTABLE,
        date_created = 'date_created' :'java.time.LocalDateTime' (OPT) (sourcetypedecimals='9', sourcetyperadix='0', sourcetypesize='29', description='', sourcetypeid='93', sourcetypename='TIMESTAMP')  SORTABLE
    );

CREATE OR REPLACE TABLE bv_lead_conversion_log I18N us_est (
        log_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Represents a unique identifier for each log entry, enabling tracking and differentiation of records within the conversion process.'),
        lead_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Denotes the unique identifier assigned to leads, providing a reference point to trace the origins of the conversion activity.'),
        conversion_date:localdate (sourcetypeid = '91', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Specifies the date on which a lead was successfully converted, offering insights into the timing of conversion activities.'),
        converted_customer_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Identifies the unique customer ID associated with a successfully converted lead, linking conversion records to specific customers.'),
        conversion_source:text (sourcetypeid = '12', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '100', description = 'Indicates the source or channel through which the conversion occurred, such as "Social Media", "Referral", "Event", or "Website". It includes values like "Social Media", "Referral", "Event", and "Website".'),
        date_created:timestamp (sourcetypeid = '93', sourcetyperadix = '0', sourcetypedecimals = '9', sourcetypesize = '29', description = 'Records the timestamp when the log entry was created, providing a chronological context for the conversion details.')
    )
    FOLDER = '/1 - dataconnection/2 - base views'
    DESCRIPTION = 'The bv_lead_conversion_log view represents a dataset that tracks lead conversion activities. It includes detailed fields such as log ID for record identification, lead ID for tracing lead origins, conversion date for understanding timing, converted customer ID for linking leads to specific customers, conversion source for identifying the channel of conversion, and date created for providing a chronological context. This view provides structured data about the conversion process, focusing on leads and their successful conversion into customers. The bv_lead_conversion_log view can be used for analyzing lead conversion activities, understanding the effectiveness of various conversion sources, tracking the timing of conversions, and linking converted leads to their respective customers. It could support business decisions related to marketing strategies, customer acquisition, and conversion optimization.'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD bv_lead_conversion_log(
        I18N us_est
        CONSTRAINTS (
             ADD log_id (any) OPT ANY
             ADD lead_id (any) OPT ANY
             ADD conversion_date (any) OPT ANY
             ADD converted_customer_id (any) OPT ANY
             ADD conversion_source (any) OPT ANY
             ADD date_created (any) OPT ANY
        )
        OUTPUTLIST (conversion_date, conversion_source, converted_customer_id, date_created, lead_id, log_id
        )
        WRAPPER (jdbc bv_lead_conversion_log)
    );

