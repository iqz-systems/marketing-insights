CREATE OR REPLACE VIEW clients FOLDER = '/3 - reports'
    TAGS (client, mcp) (
    client_identifier (description = 'Serves as a unique identifier for each client, ensuring the distinction of records within the system.') TAGS (client),
    client_entity_name (description = 'Represents the official name or title of the client entity, enabling easy recognition. It includes values like "johnson_corp", "smith_retail", "davis_consultin...", and "green_tech".') TAGS (client),
    associated_company_name (description = 'Indicates the name of the company associated with the client, providing a direct connection to their organizational identity. It includes values like "Johnson Corporation", "Smith''s Retail", "Davis Consulting", and "Green Tech Solutio...".'),
    primary_contact_name (description = 'Denotes the name of the primary contact person for the client, facilitating communication and relationship management. It includes values like "Michael Johnson", "Emily Smith", "David Davis", and "Sarah Green".'),
    contact_email (description = 'Captures the email address of the client or their representative, enabling digital correspondence. It includes values like "michael.johnson@exam...", "emily.smith@example....", "david.davis@exampl...", and "sarah.green@exampl...".') TAGS (email),
    contact_phone_number (description = 'Records the phone number of the client or their representative, ensuring accessibility for verbal communication. It includes values like "(123) 456-7890", "(987) 654-3210", "(555) 123-4567", and "(321) 876-5432".') TAGS (restricted),
    physical_address (description = 'Specifies the physical location or mailing address associated with the client, aiding logistical operations. It includes values like "123 Main St", "456 Elm St", "789 Oak St", and "111 Pine St".') TAGS (address),
    city_location (description = 'Identifies the city where the client is based, providing a geographical dimension to their location. It includes values like "New York", "Los Angeles", "Chicago", and "Seattle".') TAGS (city),
    state_region (description = 'Denotes the state or region associated with the client’s address, specifying administrative division. It includes values like "NY", "CA", "IL", and "WA".') TAGS (state),
    postal_code (description = 'Represents the postal or ZIP code corresponding to the client’s address, ensuring accurate mail delivery. It includes values like "10001", "90002", "60601", and "98101".') TAGS (postal_code),
    country_of_operation (description = 'Indicates the country of residence or operation for the client, reflecting their global presence. It includes values like "USA", "USA", "USA", and "USA".') TAGS (country),
    business_industry (description = 'Defines the sector or domain in which the client operates, reflecting their business focus. It includes values like "Technology", "Retail", "Consulting", and "Technology".'),
    client_classification (description = 'Describes the classification of the client, providing insight into their operational structure. It includes values like "Corporate", "Corporate", "Sole Proprietor", and "Startup".')
 )
 AS SELECT bv_clients.client_id AS client_identifier, bv_clients.client_name AS client_entity_name, bv_clients.company AS associated_company_name, bv_clients.contact_name AS primary_contact_name, bv_clients.email AS contact_email, bv_clients.phone AS contact_phone_number, bv_clients.address AS physical_address, bv_clients.city AS city_location, bv_clients.state AS state_region, bv_clients.zip AS postal_code, bv_clients.country AS country_of_operation, bv_clients.industry AS business_industry, bv_clients.client_type AS client_classification FROM bv_clients;

ALTER VIEW clients
 LAYOUT (bv_clients = [20, 20, 200, 200]);

