CREATE OR REPLACE VIEW resort_performance FOLDER = '/3 - reports' (
    client_title (description = 'Represents the official name or title of the client entity, enabling easy recognition. It includes values like "IQZ Plus".') TAGS (client),
    total_revenue (description = 'Represents the total financial earnings or income generated by the entity, expressed as a numeric value.') TAGS (sales),
    resort_name (description = 'Denotes the official name or identifier of the resort, facilitating easy identification. It includes values like "IQZ Plus".') TAGS (resort)
 )
 AS SELECT iv_resort_performance.client_name AS client_title, iv_resort_performance.revenue AS total_revenue, iv_resort_performance.resort AS resort_name FROM iv_resort_performance;

ALTER VIEW resort_performance
 LAYOUT (iv_resort_performance = [484, 99, 200, 200]);

